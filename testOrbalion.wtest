import orbalion.*
describe "Test de Equipo Lumínico chekpoint 1" {

  test "Un entrenador no puede tener tener un rol distinto a los autorizados por la FOZ." {
    const martin = new Entrenadores(cantidadCiclosSolares = 3, estaEnSintonia = true, nivelPrecision= 3, rol = "Estratega Cuantico")
    assert.notThat(martin.estaHomologado("Arquitecto"))
  }
  test "Un equipo lumínico con radiación > 5000 y sin tecnologías activas → su energía total es su energía base" {
    const martin = new Entrenadores(cantidadCiclosSolares = 3, estaEnSintonia = true, nivelPrecision= 3,rol="Estratega Cuantico")
    const losLuminicos = new Luminicos(nombre ="losLuminicos",nivelDeEnergiaBase = 4600 ,nivelRadiacion = 6000,entrenador = martin,cristalesSolares=4)
    assert.equals(losLuminicos.energiaTotal(),4600)
  }
  test "Un equipo lumínico con radiación < 5000 → obtiene el bono del 10%" {
    const juan = new Entrenadores(cantidadCiclosSolares = 5, estaEnSintonia = true, nivelPrecision= 2, rol="Arquitecto De Energia")
    const losLuminicazos = new Luminicos(nombre = "losLuminicazos",nivelDeEnergiaBase = 3250,nivelRadiacion=4500,entrenador=juan,cristalesSolares=3)
    assert.equals(losLuminicazos.energiaTotal(),3575)
  }
  test "Un equipo sintético con 6 módulos → aplica correctamente la penalización del 20%" {
    const pablo = new Entrenadores(cantidadCiclosSolares=5,estaEnSintonia = true, nivelPrecision= 7,rol="Guia Mental")
    const losSintatos = new Sinteticos(nombre="losSintatos",nivelDeEnergiaBase = 2500,entrenador=pablo,nivelProcesamientoCentral=4,cantidadModulos=6)
    assert.equals(losSintatos.energiaTotal(),2000)
  }
  test "Un equipo sintético con 4 módulos y 2 tecnologías complementarias → suma correctamente los valores energéticos"{
    const ignacio = new Entrenadores(cantidadCiclosSolares=12,estaEnSintonia=false,nivelPrecision=10,rol="Guia Mental")
    const aplle = new Tecnologias(nombre="aplle",valorEnergetico=300,activa=true)
    const aplletop = new Tecnologias(nombre="aplletop",valorEnergetico=700,activa=true)
    const losSintatos = new Sinteticos(nombre="losSintanos",nivelDeEnergiaBase=2500,entrenador=ignacio,nivelProcesamientoCentral=5,cantidadModulos=4,tecnologiasComplementarias=[aplle,aplletop])
    assert.equals(losSintatos.energiaTotal(),3500) 
  }
}
describe "checkpoint 2"{
  test"Estratega cuántico con 12 ciclos y precisión 90 → es de élite galáctica"{
    const mikel = new Entrenadores(cantidadCiclosSolares=12,estaEnSintonia=true,nivelPrecision=90,rol="Estratega Cuantico")
    assert.that(mikel.esDeEliteGalactica())
  }
  test"Arquitecto de energía con 11 ciclos pero sin sintonía → no es de élite."{
    const ramon = new Entrenadores(cantidadCiclosSolares=11,estaEnSintonia=false,nivelPrecision=80,rol="Arquitecto De Energia")
    assert.notThat(ramon.esDeEliteGalactica())
  }
  test"Guía mental con 15 ciclos → siempre es de élite"{
    const saul = new Entrenadores(cantidadCiclosSolares=15,estaEnSintonia=false,nivelPrecision=20,rol="Guia Mental")
    assert.that(saul.esDeEliteGalactica())
  }
}
describe"checkpoint 3"{
  test"Equipo lumínico con 3 cristales, entrenador de élite y una tecnología activa → es de prestigio universal"{
    const pedrito = new Entrenadores(cantidadCiclosSolares=11,estaEnSintonia=true,nivelPrecision=30,rol="Guia Mental")
    const pipilogia = new Tecnologias(nombre="pipilogia",valorEnergetico=500,activa=true)
    const ratilogia = new Tecnologias(nombre="ratilogia",valorEnergetico=900,activa=false)
    const paritogia = new Tecnologias(nombre="paritogia",valorEnergetico=1000,activa=false)
    const laminicos = new Luminicos(nombre="laminicos",nivelDeEnergiaBase=4000,nivelRadiacion=4000,entrenador=pedrito,cristalesSolares=3,tecnologiasComplementarias=[pipilogia,ratilogia,paritogia])
    assert.that(laminicos.esDePrestigioUniversal())
  }
  test "Equipo sintético certificado con 4 módulos y todas las tecnologías activas → es de prestigio"{
    const mario = new Entrenadores(cantidadCiclosSolares=13,estaEnSintonia=true,nivelPrecision=50,rol="Guia Mental")
    const ritilogia = new Tecnologias(nombre="ritilogia",valorEnergetico=1500,activa=true)
    const fatilogia = new Tecnologias(nombre="fatilogia",valorEnergetico=5000,activa=true)
    const pileticos = new Sinteticos(nombre="pileticos",nivelDeEnergiaBase=4000,entrenador=mario,nivelProcesamientoCentral=6,cantidadModulos=4,tecnologiasComplementarias=[ritilogia,fatilogia])
    assert.that(pileticos.esDePrestigioUniversal())
  }
  test"un equipo luminico con 2 cristales solares y ninguna tecnologia no es de prestigio"{
    const dante = new Entrenadores(cantidadCiclosSolares=13,estaEnSintonia=true,nivelPrecision=60,rol="Guia Mental")
    const pilepanos = new Luminicos(nombre="pilepanos",nivelDeEnergiaBase=6500,nivelRadiacion=500,entrenador=dante,cristalesSolares=2)
    assert.notThat(pilepanos.esDePrestigioUniversal())
  }
}